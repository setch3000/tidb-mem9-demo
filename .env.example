# cp .env.example .env 후 값을 입력하세요. .env는 git에 올리지 않습니다.

# TiDB Cloud Starter (클러스터 화면 → Connect → General)
TIDB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=invest_demo

# mem9 Hosted (curl -sX POST https://api.mem9.ai/v1alpha1/mem9s 응답의 id)
MEM9_API_URL=https://api.mem9.ai
MEM9_API_KEY=

# Claude API
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# 선택: LangSmith 추적 (켜면 프롬프트·응답이 LangSmith로 전송됨)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tidb-mem9-demo

# 관리자 이메일 (쉼표 구분): '접속 기록' 화면과 '데모 초기화' 버튼이 보인다
ADMIN_EMAILS=

# 로컬 테스트 전용: Google 로그인 없이 앱을 연다. 배포 Secrets에는 절대 넣지 않는다.
# DEMO_AUTH=off
# DEMO_DEV_EMAIL=you@example.com
