# Streamlit Community Cloud > App settings > Secrets 에 붙여넣을 내용의 틀입니다.
# 실제 값은 .streamlit/secrets.toml(로컬, git 제외) 또는 Cloud Secrets 화면에만 둡니다.
# 최상위 키는 환경변수로도 노출되어 core/config.py가 그대로 읽습니다.

TIDB_HOST = "gateway01.ap-northeast-1.prod.aws.tidbcloud.com"
TIDB_PORT = "4000"
TIDB_USER = ""
TIDB_PASSWORD = ""
TIDB_DATABASE = "invest_demo"

MEM9_API_URL = "https://api.mem9.ai"
MEM9_API_KEY = ""

ANTHROPIC_API_KEY = ""
LLM_MODEL = "claude-haiku-5-5"

ADMIN_EMAILS = ""            # 예: "you@example.com,teammate@pingcap.com"

LANGSMITH_TRACING = "false"

# Google 로그인 (st.login). 반드시 [auth] 섹션 안에 둔다 (환경변수로 노출되지 않음).
[auth]
redirect_uri = "https://<앱 이름>.streamlit.app/oauth2callback"   # 로컬: http://localhost:8501/oauth2callback
cookie_secret = ""           # 긴 무작위 문자열: python -c "import secrets; print(secrets.token_urlsafe(48))"
client_id = ""               # Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
